# Скопируй в .env и заполни. .env в git не попадает.
LLM_BACKEND=local            # local | openai   (по умолчанию local — бесплатно)

# --- OpenAI (только для финальных зачётных прогонов) ---
OPENAI_API_KEY=
BUDGET_USD_LIMIT=4.00        # жёсткий лимит; при превышении cost_guard бросает исключение

# --- Local (vLLM, OpenAI-совместимый сервер) ---
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=EMPTY
