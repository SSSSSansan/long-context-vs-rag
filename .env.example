# Скопируй в .env и заполни. .env в git не попадает.
LLM_BACKEND=local            # local | openai   (по умолчанию local — бесплатно)

# --- OpenAI (только для финальных зачётных прогонов) ---
OPENAI_API_KEY=
BUDGET_USD_LIMIT=3.00
BUDGET_SOFT_STOP_USD=2.50

# --- Local: Ollama (qwen2.5-7b-32k, см. Modelfile.qwen2.5-7b-32k); для vLLM поставьте http://localhost:8000/v1 ---
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=EMPTY
